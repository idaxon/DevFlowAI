{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask"
    },
    "demo_repository": {
      "root": "demo_repository",
      "framework": "flask"
    }
  },
  "bindings": {
    "app": [
      {
        "type": "service",
        "service": "demo_repository",
        "format": "url",
        "env": "DEMO_REPO_URL"
      }
    ]
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
