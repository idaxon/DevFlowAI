# DevFlow AI - Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=devflow-secret-key-change-in-production-2026

# AI Provider Configuration
# Supported Providers: 'demo', 'groq', 'deepseek', 'gemini'
LLM_PROVIDER=demo

# Groq API Configuration (Ultra-fast inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek API Configuration (Reasoning & Code synthesis)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini API Configuration (Gemini 2.5 Flash / Gemini 2.0 Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub Configuration
GITHUB_TOKEN=

# Platform Storage Directories
BASE_DIR=.
REPOSITORY_DIR=./repositories
VECTOR_DB_DIR=./vector_db
REPORTS_DIR=./reports

# Execution Safeguards
DOCKER_ENABLED=false
MAX_AGENT_RETRIES=3
MAX_EXECUTION_TIMEOUT_SECONDS=60
DEMO_MODE=true
